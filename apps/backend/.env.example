# KitchenPal backend environment. Copy to `.env` for local development.
# This file is the authoritative list of environment variables.

# Runtime mode: development | test | production
NODE_ENV=development

# Single canonical HTTP port for the backend.
PORT=3001

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/kitchenpal

# Redis connection URL. Optional in development: when unset, rate limiting and
# cache fall back to in-memory storage and no BullMQ queues connect.
# REDIS_URL=redis://127.0.0.1:6379

# Structured log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Global rate limit. TTL is the window in milliseconds; LIMIT is requests/window.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Serve Swagger/OpenAPI docs at /docs.
SWAGGER_ENABLED=true

# JWT signing. JWT_ACCESS_SECRET signs short-lived access tokens (required in
# production; a logged dev fallback is used when unset in development).
# Refresh tokens are opaque and stored hashed, so JWT_REFRESH_SECRET is reserved
# for future signed-refresh strategies and is not required.
# JWT_ACCESS_SECRET=replace-me-access
# JWT_REFRESH_SECRET=replace-me-refresh

# Admin bootstrap: only these emails may be elevated to admin, and only when the
# request presents the matching secret.
# ADMIN_EMAILS=owner@example.com,ops@example.com
# ADMIN_BOOTSTRAP_SECRET=replace-me-bootstrap

# Social sign-in accepted audiences (comma-separated). When unset, google/apple
# use a development-only path that is rejected when NODE_ENV=production.
# GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.kitchenpal.app

# Transactional email (Resend). When unset, verification/reset tokens are logged
# instead of sent (development only; rejected in production).
# RESEND_API_KEY=re_xxx
EMAIL_FROM=KitchenPal <noreply@kitchenpal.local>
APP_WEB_URL=http://localhost:3000

# Local avatar storage (S3 adapter in production). UPLOAD_DIR is the on-disk
# folder; UPLOAD_PUBLIC_BASE_URL is the path prefix files are served under.
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE_URL=/uploads

# Food-vision providers for pantry scans. Both optional: with neither key set,
# scans degrade to an empty, manual-entry result (never a crash, never fabricated
# detections). OpenAI is primary; Gemini is the fallback. AI_VISION_MAX_TOKENS
# caps per-scan completion tokens to bound cost.
# OPENAI_API_KEY=sk-xxx
OPENAI_VISION_MODEL=gpt-4o-mini
# GEMINI_API_KEY=xxx
GEMINI_VISION_MODEL=gemini-1.5-flash
AI_VISION_MAX_TOKENS=800

# Text-LLM models for recipe suggestions and weekly meal auto-fill. These reuse
# the OPENAI_API_KEY / GEMINI_API_KEY above. With neither key set, suggestions and
# auto-fill degrade to deterministic pantry/preference heuristics — they still
# only ever select from existing recipes, never fabricated ones.
OPENAI_TEXT_MODEL=gpt-4o-mini
GEMINI_TEXT_MODEL=gemini-1.5-flash
AI_SUGGESTION_MAX_TOKENS=600

# Google Custom Search for external recipe web-search. Both optional: without a
# key + search-engine id, external search returns an empty, flagged result
# (never a crash, never fabricated links).
# GOOGLE_SEARCH_API_KEY=xxx
# GOOGLE_SEARCH_CX=xxxxxxxxxxxx
