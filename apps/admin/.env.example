# KitchenPal admin console environment. Copy to `.env` for local development.
# Vite only exposes variables prefixed `VITE_`, and bakes them in at BUILD
# time — there is no way to change this on an already-built static bundle;
# rebuild (or re-set the platform's build-time env var) to change it.

# REST API base URL the admin console calls. Defaults to the local backend.
VITE_API_URL=http://localhost:3001
