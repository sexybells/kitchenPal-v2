{
  "extends": "@kitchenpal/config/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "target": "ESNext",
    "strict": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["expo", "jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".expo"]
}
